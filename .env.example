# Gnani speech. Leave blank to run the whole call in mock mode.
# Real mode starts as soon as this key is set. Header sent to api.vachana.ai: X-API-Key-ID
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_SPEED=0.92

# Evon is Gnani's LLM and is self-hosted only. Point this at an OpenAI-compatible
# /v1 endpoint (Evon, or any other chat model). Empty keeps the deterministic extractor.
# Eligibility is never decided by the model.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=evon
LLM_ENABLED=auto

# Optional. Leave empty on Vercel so the desk calls the same host.
# Locally, an empty value means http://<page-host>:8766.
NEXT_PUBLIC_API_BASE=
