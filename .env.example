# Gnani speech. Leave blank to run the whole call in mock mode.
# Real mode starts as soon as this key is set. Header sent to api.vachana.ai: X-API-Key-ID
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
# Optional. Empty uses Shivani with language en-IN when the caller speaks English.
GNANI_TTS_VOICE_EN=
GNANI_TTS_SPEED=0.92

# OpenAI-compatible chat. Default is Groq's fast Llama. The model only phrases
# the reply and may fill empty form fields. Scheme eligibility stays in code.
# Leave LLM_API_KEY empty to keep the deterministic lines. Do not set an SLNG key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_ENABLED=auto

# Where the browser calls the API and the voice socket.
# Leave both empty for same-origin (local dev, or a host that proxies /api and /ws).
# On Vercel, set both to the Render service and redeploy — Next inlines them at build time.
# Example:
#   NEXT_PUBLIC_API_BASE=https://janvaani-api.onrender.com
#   NEXT_PUBLIC_WS_BASE=wss://janvaani-api.onrender.com
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_BASE=
